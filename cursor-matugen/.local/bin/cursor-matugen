#!/bin/bash
set -e
COLOR_JSON="$HOME/.cache/wayle/matugen-colors.json"
PRIMARY=$(python3 -c "import json; d=json.load(open('$COLOR_JSON')); print(d['colors']['primary']['default']['color'])" 2>/dev/null || echo "#8bd5ca")
# build minimal hyprcursor theme with primary color
TMP=$(mktemp -d)
mkdir -p "$TMP/hyprcursors/left_ptr"
cat > "$TMP/manifest.hl" <<MAN
name = matugen-cursor
description = matugen dynamic
version = 0.1
cursors_directory = hyprcursors
MAN
cat > "$TMP/hyprcursors/left_ptr/meta.hl" <<META
resize_algorithm = none
hotspot_x = 0.08
hotspot_y = 0.04
define_size = 24, left_ptr.svg, 50
define_size = 32, left_ptr.svg, 50
define_size = 48, left_ptr.svg, 50
META
cat > "$TMP/hyprcursors/left_ptr/left_ptr.svg" <<SVG
<svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path d="M2 2 L2 28 L9 21 L13 29 L17 27 L13 19 L21 19 Z" fill="$PRIMARY" stroke="#1a1a1a" stroke-width="1.2" stroke-linejoin="round"/></svg>
SVG
# also create default alias
mkdir -p "$TMP/hyprcursors/default"
cp "$TMP/hyprcursors/left_ptr/meta.hl" "$TMP/hyprcursors/default/meta.hl"
cp "$TMP/hyprcursors/left_ptr/left_ptr.svg" "$TMP/hyprcursors/default/default.svg"
hyprcursor-util --create "$TMP" 2>/dev/null
# output is at /tmp/theme_matugen-cursor (from hyprcursor-util)
OUT="/tmp/theme_matugen-cursor"
if [ -d "$OUT" ]; then
  rm -rf "$HOME/.icons/matugen-cursor"
  mv "$OUT" "$HOME/.icons/matugen-cursor"
  # add fallback index.theme
  cat > "$HOME/.icons/matugen-cursor/index.theme" <<THEME
[Icon Theme]
Name=matugen-cursor
Inherits=Catppuccin-Macchiato-Teal-Cursors
THEME
  hyprctl setcursor matugen-cursor 24 2>/dev/null || true
  echo "cursor -> $PRIMARY"
fi
rm -rf "$TMP"
