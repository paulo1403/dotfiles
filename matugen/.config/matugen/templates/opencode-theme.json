{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "cobalt": "{{ colors.primary.default.hex }}",
    "cobaltLight": "{{ colors.primary.default.hex }}",
    "steel": "{{ colors.primary.default.hex }}",
    "text": "{{ colors.on_surface.default.hex }}",
    "textBright": "{{ colors.on_surface.default.hex }}",
    "muted": "{{ colors.outline.default.hex }}",
    "mutedDim": "{{ colors.outline_variant.default.hex }}",
    "bg": "{{ colors.background.default.hex }}",
    "bgPanel": "{{ colors.surface.default.hex }}",
    "bgElement": "{{ colors.surface_variant.default.hex }}",
    "border": "{{ colors.outline.default.hex }}",
    "borderNavy": "{{ colors.outline.default.hex }}",
    "rose": "{{ colors.error.default.hex }}",
    "roseLight": "{{ colors.error.default.hex }}",
    "sea": "{{ colors.secondary.default.hex }}",
    "sand": "{{ colors.tertiary.default.hex }}"
  },
  "theme": {
    "primary": { "dark": "cobalt", "light": "#4a76b8" },
    "secondary": { "dark": "cobaltLight", "light": "cobalt" },
    "accent": { "dark": "cobalt", "light": "#4a76b8" },
    "error": { "dark": "rose", "light": "#b84a5a" },
    "warning": { "dark": "sand", "light": "#b08a2e" },
    "success": { "dark": "sea", "light": "#4e7a68" },
    "info": { "dark": "muted", "light": "#5a7a94" },
    "text": { "dark": "text", "light": "#2e3642" },
    "textMuted": { "dark": "muted", "light": "#66798f" },
    "background": { "dark": "bg", "light": "#e8edf4" },
    "backgroundPanel": { "dark": "bgPanel", "light": "#dde4ee" },
    "backgroundElement": { "dark": "bgElement", "light": "#d0d9e6" },
    "border": { "dark": "border", "light": "#c0cad8" },
    "borderActive": { "dark": "cobalt", "light": "#4a76b8" },
    "borderSubtle": { "dark": "border", "light": "#c0cad8" },
    "diffAdded": { "dark": "sea", "light": "#4e7a68" },
    "diffRemoved": { "dark": "rose", "light": "#b84a5a" },
    "diffContext": { "dark": "muted", "light": "#66798f" },
    "diffHunkHeader": { "dark": "cobalt", "light": "#4a76b8" },
    "markdownHeading": { "dark": "cobaltLight", "light": "#4a76b8" },
    "markdownLink": { "dark": "cobalt", "light": "#4a76b8" },
    "markdownCode": { "dark": "cobalt", "light": "#5a7a94" },
    "syntaxKeyword": { "dark": "cobaltLight", "light": "#4a5a8e" },
    "syntaxFunction": { "dark": "cobalt", "light": "#4a76b8" },
    "syntaxString": { "dark": "sea", "light": "#4e7a68" },
    "syntaxNumber": { "dark": "roseLight", "light": "#b84a5a" },
    "syntaxComment": { "dark": "mutedDim", "light": "#66798f" },
    "syntaxType": { "dark": "cobalt", "light": "#4a5a8e" }
  }
}
