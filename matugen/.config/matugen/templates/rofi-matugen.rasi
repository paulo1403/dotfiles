* {
    bg-col:  {{ colors.background.default.hex }};
    bg-col-light: {{ colors.surface.default.hex }};
    border-col: {{ colors.outline.default.hex }};
    selected-col: {{ colors.primary.default.hex }};
    blue: {{ colors.primary.default.hex }};
    fg-col: {{ colors.on_surface.default.hex }};
    fg-col2: {{ colors.error.default.hex }};
    grey: {{ colors.outline_variant.default.hex }};
    teal: {{ colors.secondary.default.hex }};
    width: 600;
    border-radius: 15px;
}
